digraph architecture {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.45, bgcolor="white", pad=0.2];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#5b6472", fillcolor="#f4f6f8", penwidth=1.1];
  edge  [fontname="Helvetica", fontsize=8.5, color="#5b6472", arrowsize=0.7];

  kaggle [label="Kaggle API\nrossmann-store-sales\ntrain / store / test (CSV)", fillcolor="#fff4e0", color="#c58a2b"];

  subgraph cluster_local {
    label="docker-compose (red pset2_net)"; fontname="Helvetica"; fontsize=10; style="rounded,dashed"; color="#8a93a3";
    kestra [label="Kestra\nSchedule 05:00 COT · retries\nbackfill mensual", fillcolor="#e8eefc", color="#3d63c9"];
    pg     [label="Postgres\n(metadatos Kestra)", fillcolor="#ffffff"];
    dbt    [label="dbt Core (contenedor)\nbuild + tests", fillcolor="#fdeee8", color="#d0623a"];
    spark  [label="Spark standalone\nmaster + worker\ndriver: spark-submit", fillcolor="#fdf6dc", color="#b7911c"];
  }

  subgraph cluster_sf {
    label="Snowflake · PSET2_ROSSMANN"; fontname="Helvetica"; fontsize=10; style="rounded"; color="#2a9bd6";
    stage  [label="Stage\nRAW.ROSSMANN_LANDING", fillcolor="#e6f4fb", color="#2a9bd6"];
    raw    [label="RAW\nVARCHAR + metadatos\n+ INGESTION_LOG", fillcolor="#e6f4fb", color="#2a9bd6"];
    bronze [label="BRONZE\nvistas tipadas 1:1", fillcolor="#e6f4fb", color="#2a9bd6"];
    silver [label="SILVER\nstaging limpio\n+ DQ_METRICS", fillcolor="#e6f4fb", color="#2a9bd6"];
    gold   [label="GOLD\nstar schema", fillcolor="#e6f4fb", color="#2a9bd6"];
    obt    [label="OBT\nOBT_SALES_DAILY\n+ VALIDATION_LOG", fillcolor="#e6f4fb", color="#2a9bd6"];
  }

  kaggle -> kestra [label="descarga +\nvalida esquema"];
  kestra -> pg [dir=both, style=dotted, arrowsize=0.5];
  kestra -> stage [label="PUT .csv.gz"];
  stage -> raw [label="DELETE+INSERT\npor ventana"];
  raw -> bronze [label="dbt", fontcolor="#d0623a", color="#d0623a"];
  bronze -> silver [label="dbt", fontcolor="#d0623a", color="#d0623a"];
  silver -> gold [label="dbt", fontcolor="#d0623a", color="#d0623a"];
  gold -> obt [label="Spark", fontcolor="#b7911c", color="#b7911c"];

  kestra -> dbt [style=dashed, label="lanza"];
  kestra -> spark [style=dashed, label="lanza"];
}
