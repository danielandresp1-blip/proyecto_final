digraph arquitectura_final {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.3, ranksep=0.4, bgcolor="white", pad=0.2];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#5b6472", fillcolor="#f4f6f8", penwidth=1.1];
  edge  [fontname="Helvetica", fontsize=8.5, color="#5b6472", arrowsize=0.7];

  kaggle [label="Kaggle\nrossmann-store-sales", fillcolor="#fff4e0", color="#c58a2b"];

  subgraph cluster_datos {
    label="Datos (PSet 2) · Kestra + dbt + Spark"; fontname="Helvetica"; fontsize=10; style="rounded"; color="#2a9bd6";
    raw  [label="RAW", fillcolor="#e6f4fb", color="#2a9bd6"];
    capas [label="BRONZE → SILVER\n→ GOLD (dbt)", fillcolor="#e6f4fb", color="#2a9bd6"];
    obt  [label="OBT tienda × día\n(Spark)", fillcolor="#e6f4fb", color="#2a9bd6"];
  }

  subgraph cluster_modelo {
    label="Modelo (PSet 3)"; fontname="Helvetica"; fontsize=10; style="rounded"; color="#7a4fc9";
    nb   [label="Notebooks\nEDA, features,\nentrenamiento", fillcolor="#f1ebfb", color="#7a4fc9"];
    mlf  [label="MLflow\nModel Registry\nchampion / challenger", fillcolor="#f1ebfb", color="#7a4fc9"];
  }

  subgraph cluster_op {
    label="Operación (PSet 4) · Kestra produccion_lotes"; fontname="Helvetica"; fontsize=10; style="rounded"; color="#2f9e5b";
    api  [label="API FastAPI\n/predecir → pronóstico\n+ decisión de turnos", fillcolor="#e7f6ec", color="#2f9e5b"];
    pred [label="OPERACION.\nPREDICCIONES", fillcolor="#e6f4fb", color="#2a9bd6"];
    mon  [label="Monitoreo\ndesempeño, deriva,\ncalidad → ALERTAS", fillcolor="#e7f6ec", color="#2f9e5b"];
    reen [label="Reentrenamiento\nchallenger + pausa\n(aprobación humana)", fillcolor="#e7f6ec", color="#2f9e5b"];
    tab  [label="Tablero\nStreamlit", fillcolor="#ffffff"];
  }

  gh [label="GitHub Actions\nCI: pytest · CD: imagen en GHCR", fillcolor="#fdeee8", color="#d0623a"];
  ger [label="Gerente de tienda\narma los turnos", fillcolor="#fff4e0", color="#c58a2b"];

  kaggle -> raw -> capas -> obt;
  obt -> nb [label="lee"];
  nb -> mlf [label="registra"];
  mlf -> api [label="carga @champion"];
  obt -> api [label="features del lote", style=dashed];
  api -> pred;
  api -> ger [label="pronóstico\n+ decisión"];
  pred -> mon [label="+ ventas reales"];
  mon -> reen [label="WAPE alto\n2 lotes"];
  reen -> mlf [label="si se aprueba:\nmueve champion"];
  mon -> tab; pred -> tab;
  gh -> api [style=dashed, label="imagen"];
}
