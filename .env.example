# Copia este archivo a .env y completa los valores. .env NUNCA se sube al repositorio.

# --- Snowflake (autenticacion por par de llaves; la llave privada va en secrets/rsa_key.p8) ---
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=PSET2_SVC
SNOWFLAKE_ROLE=PSET2_ROLE
SNOWFLAKE_WAREHOUSE=PSET2_WH
SNOWFLAKE_DATABASE=PSET2_ROSSMANN

# --- Kaggle (fuente: competencia rossmann-store-sales; hay que aceptar sus reglas en kaggle.com) ---
KAGGLE_USERNAME=tu_usuario_kaggle
KAGGLE_KEY=tu_api_key_kaggle

# --- Kestra ---
KESTRA_IMAGE=kestra/kestra:latest
# El usuario debe ser un correo valido; la clave necesita 8+ caracteres, una mayuscula y un numero
KESTRA_ADMIN_USER=admin@pset2.local
KESTRA_ADMIN_PASSWORD=CambiaEsto123
KESTRA_DB_PASSWORD=cambia_esto_tambien

# --- dbt ---
DBT_IMAGE=ghcr.io/dbt-labs/dbt-snowflake:1.9.latest

# --- Spark ---
SPARK_IMAGE=apache/spark:3.5.3-scala2.12-java17-python3-ubuntu
# El conector 3.x resuelve su driver JDBC compatible como dependencia transitiva
SPARK_SNOWFLAKE_PACKAGES=net.snowflake:spark-snowflake_2.12:3.1.2
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3g
